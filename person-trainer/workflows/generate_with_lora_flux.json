{
  "_comment": "API-format FLUX + LoRA generation template. person-trainer substitutes the {{TOKEN}} placeholders before POSTing the 'prompt' object to ComfyUI's /prompt endpoint.",
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "flux1-dev.safetensors", "weight_dtype": "fp8_e4m3fn" }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["1", 0],
        "lora_name": "{{LORA_FILENAME}}",
        "strength_model": "{{LORA_STRENGTH}}"
      }
    },
    "3": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "clip_l.safetensors",
        "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
        "type": "flux"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": { "clip": ["3", 0], "text": "{{PROMPT}}" }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": { "clip": ["3", 0], "text": "" }
    },
    "6": {
      "class_type": "FluxGuidance",
      "inputs": { "conditioning": ["4", 0], "guidance": 3.5 }
    },
    "7": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "ae.safetensors" }
    },
    "8": {
      "class_type": "EmptySD3LatentImage",
      "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["2", 0],
        "positive": ["6", 0],
        "negative": ["5", 0],
        "latent_image": ["8", 0],
        "seed": "{{SEED}}",
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["9", 0], "vae": ["7", 0] }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": { "images": ["10", 0], "filename_prefix": "{{FILENAME_PREFIX}}" }
    }
  }
}
